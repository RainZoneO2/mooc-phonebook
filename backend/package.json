{
  "name": "phonebook-backend",
  "version": "0.0.1",
  "description": "Backend for phonebook",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "remote:push": "cd .. && git add . && git commit -m uibuild && git push",
    "build:ui": "rm -rf dist && cd ../frontend && npm run build && cp -r dist ../backend && rm -rf dist",
    "deploy:full": "npm run build:ui && npm run commit-all"
  },
